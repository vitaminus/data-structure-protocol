{
  "name": "dsp",
  "private": true,
  "version": "0.3.0",
  "description": "Data Structure Protocol - context compiler for AI coding agents",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "bench:smoke": "tsx bench/scripts/bench-smoke.ts",
    "bench:compare": "tsx bench/scripts/bench-compare.ts",
    "coverage:summary": "tsx scripts/coverage-summary.ts",
    "dsp": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
