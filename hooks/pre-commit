#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=dsp-hook-lib.sh
source "$SCRIPT_DIR/dsp-hook-lib.sh"

if [[ "${DSP_HOOK_SKIP:-0}" == "1" ]]; then
  echo "DSP: hook skipped via DSP_HOOK_SKIP=1"
  exit 0
fi

"$SCRIPT_DIR/dsp-check-staged.sh"

echo "DSP: validating graph"
_dsp_cmd validate "$DSP_ROOT" --json > "$DSP_JSON_DIR/validate.json"
errors=$(_dsp_validation_error_count "$DSP_JSON_DIR/validate.json")
if [[ "$errors" != "0" ]]; then
  echo "DSP: validation failed with $errors error(s)" >&2
  _dsp_json_pretty_print "$DSP_JSON_DIR/validate.json"
  exit 1
fi

echo "DSP: pre-commit passed"
